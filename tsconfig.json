{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "server", "e2e", "scripts", "expo-env.d.ts", ".expo/types/**/*.ts"],
  "exclude": ["node_modules", "src/data/*.json"]
}
